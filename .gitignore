# Resultado de la construcción
dist/

# Tipos generados por Astro
.astro/

# Estado local de wrangler: incluye la copia local de la base de datos
.wrangler/

# Dependencias
node_modules/

# Registros
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno y secretos.
# .dev.vars contiene el secreto que firma las cookies de sesión: NUNCA se versiona.
.env
.env.production
.dev.vars
.dev.vars.*
!.dev.vars.ejemplo

# Respaldos de la base. Se generan con `wrangler d1 export` antes de tocar
# producción. No se versionan: contienen datos y crecen sin control. Cuando
# haya información real, además serían datos personales dentro del repositorio.
respaldos/

# Lo descartado. La convención del proyecto es que nada se borra del disco: se
# mueve aquí y Liber lo vacía a mano. Pero es un cesto de basura, no parte del
# proyecto, y no tiene por qué viajar al repositorio ni a la entrega.
#
# Van los dos nombres: el nuevo y el viejo —con espacio—, por si queda algún
# rastro del anterior en otra máquina. Un nombre con espacio obliga a comillas
# en cada comando y es una invitación a un `rm` mal escrito.
_a-borrar/
a borrar/

# Carga inicial del padrón. Ni las fotografías reales ni lo que el guion genera
# a partir de ellas entran al repositorio: son datos de operación, pesan, y la
# migración resultante se mueve a mano a `migraciones/` cuando está revisada.
# La carpeta `prueba/` sí se versiona —es el ensayo del guion—, su salida no.
carga-inicial/fotografias/
carga-inicial/salida/
carga-inicial/prueba/salida/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Configuración de editores
.idea/
