{
  // Identidad del Worker y enlaces con los servicios de Cloudflare.
  //
  // IMPORTANTE: aquí NO van "main" ni "assets".
  // El adaptador de Astro toma este archivo, le agrega el punto de entrada y
  // las carpetas que produce al construir, y escribe la configuración
  // completa en dist/server/wrangler.json. Esa es la que se despliega:
  //
  //     npx wrangler deploy -c dist/server/wrangler.json
  //
  // Si se declaran aquí, el servidor de desarrollo falla, porque apuntan a
  // archivos que sólo existen después de `npm run build`.
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "amar-es-adoptar",
  "compatibility_date": "2026-09-16",

  // Necesario para que funcionen en el Worker las partes de Astro que
  // esperan las interfaces de Node.
  "compatibility_flags": ["nodejs_compat"],

  // Base de datos D1 (SQLite administrado por Cloudflare).
  // El enlace se llama DB: así se consulta como env.DB en el código, sin
  // repetir el nombre del proyecto en cada consulta.
  //   npx wrangler d1 execute amar-es-adoptar --local  --file=./migraciones/0001_inicial.sql
  //   npx wrangler d1 execute amar-es-adoptar --remote --file=./migraciones/0001_inicial.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amar-es-adoptar",
      "database_id": "d5ca9fbd-bcbb-4f4a-8517-6c647957974b"
    }
  ],

  // Espacio KV que el adaptador de Astro declara para sus sesiones.
  //
  // El proyecto NO lo usa: la sesión del personal viaja en una cookie firmada
  // (ver src/servidor/sesion.js). Se declara aquí con su identificador ya
  // creado para que el despliegue automático no tenga que aprovisionarlo:
  // el token de construcción no tiene permiso para crear recursos, y ése era
  // el motivo de que fallara la publicación desde GitHub.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "78f2ce09f93043b29214e35985550dd8"
    }
  ],

  "observability": {
    "enabled": true
  }
}
