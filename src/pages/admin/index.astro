---
/* Página de diagnóstico de la conexión con la base de datos.
   Es la primera página que se genera en el servidor: comprueba que el
   Worker alcanza D1 y que los catálogos y los ejemplares están donde
   deben. Se sustituye por el catálogo de administración en el paso 4. */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { obtenerBase } from '../../servidor/base-de-datos.js';

// La persona la deja aquí el filtro de acceso (src/middleware.js).
// Si esta página se está mostrando, es que ya pasó el control de sesión.
const persona = Astro.locals.persona;

let error = null;
let resumen = null;

try {
  const db = obtenerBase();

  const [ejemplares, fotografias, usuarios, porCentro, porCondicion] = await Promise.all([
    db.prepare('SELECT COUNT(*) AS n, SUM(es_ficticio) AS ficticios FROM ejemplar').first(),
    db.prepare('SELECT COUNT(*) AS n FROM fotografia').first(),
    db.prepare('SELECT COUNT(*) AS n FROM usuario').first(),
    db.prepare(`SELECT c.etiqueta, COUNT(e.id) AS n
                FROM centro c LEFT JOIN ejemplar e ON e.centro_actual_clave = c.clave
                GROUP BY c.clave ORDER BY c.orden`).all(),
    db.prepare(`SELECT condicion, COUNT(*) AS n FROM ejemplar
                GROUP BY condicion ORDER BY condicion`).all(),
  ]);

  resumen = { ejemplares, fotografias, usuarios, porCentro: porCentro.results, porCondicion: porCondicion.results };
} catch (e) {
  error = e.message;
}
---
<Base titulo="Diagnóstico">
  <div class="contenedor diagnostico">
    <div class="barra-sesion">
      <p class="quien">
        <span class="nombre">{persona.nombre}</span>
        <span class="perfil">
          {persona.rol === 'ADMIN_GLOBAL'
            ? 'Administración global'
            : `Capturista · ${persona.centro_etiqueta}`}
        </span>
      </p>
      <a class="salir" href="/admin/salir">Cerrar sesión</a>
    </div>

    <p class="antetitulo">Administración</p>
    <h1>Diagnóstico de la base de datos</h1>

    {error && (
      <p class="error"><strong>No hay conexión.</strong> {error}</p>
    )}

    {resumen && (
      <>
        <p class="ok">Conexión establecida con la base <code>amar-es-adoptar</code>.</p>

        <dl class="cifras">
          <div>
            <dt>Ejemplares</dt>
            <dd>{resumen.ejemplares.n} <span>({resumen.ejemplares.ficticios} ficticios)</span></dd>
          </div>
          <div>
            <dt>Fotografías</dt>
            <dd>{resumen.fotografias.n}</dd>
          </div>
          <div>
            <dt>Personal registrado</dt>
            <dd>{resumen.usuarios.n}</dd>
          </div>
        </dl>

        <h2>Por centro</h2>
        <ul>
          {resumen.porCentro.map((f) => <li>{f.etiqueta}: <strong>{f.n}</strong></li>)}
        </ul>

        <h2>Por condición</h2>
        <ul>
          {resumen.porCondicion.map((f) => <li>{f.condicion}: <strong>{f.n}</strong></li>)}
        </ul>
      </>
    )}
  </div>
</Base>

<style>
  .diagnostico { padding-block: 26px 56px; max-width: 46rem; }

  .barra-sesion {
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px; flex-wrap: wrap;
    border-bottom: 1px solid var(--linea); padding-bottom: 14px; margin-bottom: 24px;
  }
  .quien { margin: 0; }
  .quien .nombre { display: block; font-weight: 500; color: var(--texto); }
  .quien .perfil { display: block; font-size: 0.8125rem; color: var(--gris-claro); }
  .salir { font-size: 0.875rem; color: var(--guinda); }
  h1 { color: var(--guinda); font-size: 1.625rem; margin: 0 0 18px; }
  h2 { color: var(--texto); font-size: 1rem; margin: 26px 0 8px; }
  ul { color: var(--gris); padding-left: 20px; }
  .ok { color: var(--gris); border-left: 3px solid var(--dorado); padding-left: 14px; }
  .error { color: var(--guinda); border-left: 3px solid var(--guinda); padding-left: 14px; }
  .cifras { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); margin: 24px 0 0; }
  .cifras dt { font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris-claro); }
  .cifras dd { margin: 4px 0 0; font-family: var(--titulos); font-size: 1.5rem; color: var(--guinda); }
  .cifras dd span { font-family: var(--cuerpo); font-size: 0.8125rem; color: var(--gris-claro); }
</style>
