---
/* Inicio de la administración: qué hay y qué se puede hacer. */
export const prerender = false;

import Administracion from '../../layouts/Administracion.astro';
import { resumen } from '../../servidor/ejemplares-admin.js';

const persona = Astro.locals.persona;

let cifras = null;
let error = null;

try {
  cifras = await resumen(persona);
} catch (e) {
  /* El detalle va al registro del servidor, no a la pantalla: el mensaje de
     una excepción puede llevar fragmentos de SQL o nombres de columna. Quien
     mira la pantalla no puede hacer nada con eso, y es justo lo que el
     formulario público ya se cuida de no enseñar. */
  console.error('[inicio] falló el resumen:', e);
  error = 'Vuelve a intentarlo en unos minutos; si sigue igual, avisa a quien administra el sistema.';
}

const alcance = persona.rol === 'CAPTURISTA'
  ? `Estás viendo únicamente los ejemplares de ${persona.centro_etiqueta}.`
  : 'Estás viendo los ejemplares de los tres centros.';
---
<Administracion titulo="Inicio" persona={persona}>
  <h1>Hola, {persona.nombre.split(' ')[0]}</h1>
  <p class="alcance">{alcance}</p>

  {error && <p class="error"><strong>No hay conexión con la base.</strong> {error}</p>}

  {cifras && (
    <>
      <dl class="cifras">
        <div>
          <dt>Disponibles</dt>
          <dd>{cifras.disponibles}</dd>
        </div>
        <div>
          <dt>En proceso</dt>
          <dd>{cifras.enProceso}</dd>
        </div>
        <div>
          <dt>Adoptados</dt>
          <dd>{cifras.adoptados}</dd>
        </div>
        <div class="apagada">
          <dt>Total registrados</dt>
          <dd>{cifras.total}</dd>
        </div>
      </dl>

      <p class="accion">
        <a class="boton boton-solido" href="/admin/catalogo">Ir al catálogo</a>
      </p>
    </>
  )}

  <section class="estado-sistema">
    <h2>Estado del sistema</h2>
    <p class="nota">
      Esta sección es de desarrollo: se retira al entregar la plataforma.
    </p>

    <div class="dos-columnas">
      <div>
        <h3>Funcionando</h3>
        <ul class="listo">
          <li>Catálogo con filtros, búsqueda y ordenamiento</li>
          <li>Alta y edición de ejemplar, con bitácora</li>
          <li>Fotografías con recorte y cuatro tamaños</li>
          <li>Baja y borrado de ejemplar, con respaldo en bitácora</li>
          <li>Portal público alimentado por esta misma base</li>
          <li>Solicitudes de adopción: formulario, recepción y seguimiento</li>
          <li>Descarga de solicitudes en CSV</li>
          <li>Indicadores de operación</li>
          <li>Personal con acceso, con alcance por centro</li>
        </ul>
      </div>

      <div>
        <h3>Falta</h3>
        <ul class="falta">
          <li>Montar Llave CDMX — depende de ADIP</li>
          <li>Aviso de privacidad — depende de la Unidad de Transparencia</li>
          <li>Cuenta institucional de Cloudflare — depende de Administración</li>
          <li>Retirar los registros de prueba y cargar el padrón real</li>
          <li>Accesibilidad, rendimiento y paquete de entrega (etapa 6)</li>
        </ul>
      </div>
    </div>
  </section>
</Administracion>

<style>
  .estado-sistema { margin-top: 44px; border-top: 1px solid var(--linea); padding-top: 24px; }
  .estado-sistema h2 {
    font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--gris); margin: 0 0 6px;
  }
  .estado-sistema .nota { margin: 0 0 18px; font-size: 0.8125rem; color: var(--gris-claro); }
  .estado-sistema h3 {
    font-size: 0.875rem; font-family: var(--cuerpo); font-weight: 500;
    color: var(--texto); margin: 0 0 8px;
  }
  .dos-columnas { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .estado-sistema ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .estado-sistema li {
    font-size: 0.875rem; color: var(--gris);
    display: grid; grid-template-columns: 1.25rem 1fr; align-items: baseline;
  }
  .listo li::before { content: '✓'; color: var(--exito); font-weight: 700; }
  .falta li::before { content: '·'; color: var(--gris-claro); font-weight: 700; }

  h1 { color: var(--principal); font-size: 1.625rem; margin: 0 0 6px; }
  .alcance { color: var(--gris); margin: 0 0 28px; }

  .error { color: var(--alto); border-left: 3px solid var(--alto); padding-left: 14px; }

  .cifras {
    display: grid; gap: 14px; margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .cifras div {
    border: 1px solid var(--linea); border-radius: 10px; padding: 16px 18px;
  }
  .cifras dt {
    font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--gris-claro);
  }
  .cifras dd {
    margin: 6px 0 0; font-family: var(--titulos); font-weight: 700;
    font-size: 1.875rem; color: var(--principal);
  }
  .cifras .apagada dd { color: var(--gris); }

  .accion { margin: 26px 0 0; }

</style>
